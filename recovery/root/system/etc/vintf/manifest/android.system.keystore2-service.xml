<!--
    Input:
        system/security/keystore2/android.system.keystore2-service.xml
    Fixed: manifest version downgraded from 9.0 to 1.0.
    Reason: OrangeFox fox_14.1 uses libvintf@8.0 which does not recognize version 9.0.
    Version 9.0 was introduced in AOSP Android 16 (libvintf@9.0).
    Version 1.0 is valid for AIDL manifests with explicit <version> tags.
-->
<manifest version="1.0" type="framework">
    <hal format="aidl">
        <name>android.system.keystore2</name>
        <version>5</version>
        <fqname>IKeystoreService/default</fqname>
    </hal>
</manifest>
