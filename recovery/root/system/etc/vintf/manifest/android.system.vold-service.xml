<!--
    Input:
        system/vold/android.system.vold-service.xml
    Fixed: manifest version downgraded from 9.0 to 1.0.
    Reason: OrangeFox fox_14.1 uses libvintf@8.0 which does not recognize version 9.0.
    Version 9.0 was introduced in AOSP Android 16 (libvintf@9.0).
    Version 1.0 is valid for AIDL-only manifests and has been supported since Android 8.0.
-->
<manifest version="1.0" type="framework">
    <hal format="aidl">
        <name>android.system.vold</name>
        <fqname>IVold/default</fqname>
    </hal>
</manifest>
