on init
    chown system system /dev/0:0:0:49476

on post-fs-data
    mkdir /data/vendor/trusty 0770 system system

on property:vendor.teefs_state=ready
    start vendor.keymint-mitee
    start vendor.gatekeeper-mitee
    start keystore2

on property:twrp.all.users.decrypted=true
    stop keystore2
    stop vendor.gatekeeper-mitee
    stop vendor.keymint-mitee
    stop tee-supplicant
    stop mtk_storageproxyd
