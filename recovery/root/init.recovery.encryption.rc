on init
    # Set correct SELinux contexts for MITEE/TEE/keystore binaries
    chcon u:object_r:vendor_file:s0 /vendor/bin/tee-supplicant
    chcon u:object_r:vendor_file:s0 /vendor/bin/hw/android.hardware.gatekeeper-service.mitee
    chcon u:object_r:vendor_file:s0 /vendor/bin/hw/android.hardware.security.keymint@4.0-service.mitee
    chcon u:object_r:system_file:s0 /system/bin/keystore2
    chcon u:object_r:system_file:s0 /system/bin/gatekeeperd
    chcon u:object_r:vendor_file:s0 /vendor/bin/init.insmod.sh

    start tee-supplicant
    start mtk_storageproxyd

    # Give TEE a moment to initialize
    wait /dev/mitee 5

    enable vendor.keymint-mitee
    start vendor.keymint-mitee
    start vendor.gatekeeper_mitee
    start keystore2

on property:twrp.all.users.decrypted=true
    stop keystore2
    stop vendor.gatekeeper_mitee
    stop vendor.keymint-mitee
    stop mtk_storageproxyd
    stop tee-supplicant
