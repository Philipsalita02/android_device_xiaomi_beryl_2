# Refer to following files for selinux policy
#    device/mediatek/sepolicy/base/vendor/file_contexts
#    device/mediatek/sepolicy/base/vendor/mtk_storageproxyd.te
#    device/mediatek/sepolicy/base/vendor/tee.te

service mtk_storageproxyd /vendor/bin/mtk_storageproxyd -d /dev/trusty-ipc-dev0 -g /dev/trusty-ipc-dev0 -p /data/vendor/trusty -r /dev/0\:0\:0\:49476
    class main
    capabilities DAC_READ_SEARCH SYS_RAWIO
    priority 10
    task_profiles ServiceCapacityLow
    user system
    group package_info
    seclabel u:r:recovery:s0
    disabled

on post-fs-data
    mkdir /data/vendor/trusty 0770 system system

on init
    chown system /dev/0:0:0:49476
