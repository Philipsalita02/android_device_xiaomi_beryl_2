import /init.recovery.encryption.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 0
    restorecon /vendor/bin/tee-supplicant
    restorecon /vendor/bin/hw/android.hardware.gatekeeper-service.mitee
    restorecon /vendor/bin/hw/android.hardware.security.keymint@4.0-service.mitee
    restorecon /system/bin/keystore2
    restorecon /system/bin/gatekeeperd
    restorecon /vendor/bin/init.insmod.sh

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    # write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on boot
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
